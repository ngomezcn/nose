<Window x:Class="AICopilotCore.Ui.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="AI Copilot" Width="1600" Height="950"
        MinWidth="980" MinHeight="620"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource ShellBg}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <!-- Chrome propio en vez de AllowsTransparency: con transparencia WPF
         pierde la aceleracion por hardware y la ventana deja de comportarse
         como una ventana normal (snap, maximizar, redimensionar por el
         borde). WindowChrome quita la barra de titulo nativa conservando
         todo eso; CaptionHeight=0 porque la barra de titulo se arrastra a
         mano (ver OnTitleBarDrag) y asi los botones de dentro siguen
         recibiendo clics. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="ShellRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <!-- ================= Barra de titulo ================= -->
        <Border Grid.Row="0" Background="{StaticResource ChromeBg}"
                BorderBrush="{StaticResource ShellBorder}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="OnTitleBarDrag">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0"
                            VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource CyanText}" Margin="0,0,8,0"/>
                    <TextBlock Text="AI Copilot" FontFamily="{StaticResource AICopilotFont}"
                               FontSize="13" Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="X-Plane 12" FontFamily="{StaticResource AICopilotFont}"
                               FontSize="10" Foreground="{StaticResource TextFaint}"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding BuildText}" Margin="0,0,12,0"
                           FontFamily="{StaticResource MonoFont}" FontSize="11"
                           Foreground="{StaticResource TextFaint}" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;"
                            Click="OnMinimizeClick" ToolTip="Minimizar (X-Plane le sigue)"/>
                    <!-- El glifo lo elige un DataTrigger sobre el WindowState en
                         vez de una propiedad en C#: asi los codepoints de
                         Segoe MDL2 viven todos aqui, escritos como entidades
                         XML, y el .cs se queda en ASCII puro. -->
                    <Button Click="OnMaximizeClick" ToolTip="Maximizar / restaurar">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
                                <Setter Property="Content" Value="&#xE922;"/>
                                <Style.Triggers>
                                    <DataTrigger Value="Maximized"
                                                 Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <Setter Property="Content" Value="&#xE923;"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;"
                            Click="OnCloseClick" ToolTip="Cerrar el core (X-Plane sigue abierto)"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Cuerpo ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition x:Name="LeftCol" Width="280" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="RightCol" Width="240" MinWidth="180"/>
            </Grid.ColumnDefinitions>

            <!-- Barra de actividad: cambia solo el contenido del panel izquierdo. -->
            <Border Grid.Column="0" Background="{StaticResource ActivityBarBg}"
                    BorderBrush="{StaticResource ShellBorder}" BorderThickness="0,0,1,0">
                <StackPanel>
                    <ToggleButton x:Name="AircraftTab" Style="{StaticResource ActivityToggle}"
                                  FontFamily="Segoe MDL2 Assets" Content="&#xE8F1;" IsChecked="True"
                                  Checked="OnLeftViewChanged" Click="OnLeftViewClick"
                                  ToolTip="Aviones: elegir foco y camara"/>
                    <ToggleButton x:Name="TakeoffTab" Style="{StaticResource ActivityToggle}"
                                  FontFamily="Segoe MDL2 Assets" Content="&#xE709;"
                                  Checked="OnLeftViewChanged" Click="OnLeftViewClick"
                                  ToolTip="Ruta: despegue o vuelo segun donde este el avion"/>
                    <ToggleButton x:Name="ActionsTab" Style="{StaticResource ActivityToggle}"
                                  FontFamily="Segoe MDL2 Assets" Content="&#xE8FD;"
                                  Checked="OnLeftViewChanged" Click="OnLeftViewClick"
                                  ToolTip="Acciones"/>
                    <ToggleButton x:Name="InterceptTab" Style="{StaticResource ActivityToggle}"
                                  FontFamily="Segoe MDL2 Assets" Content="&#xE945;"
                                  Checked="OnLeftViewChanged" Click="OnLeftViewClick"
                                  ToolTip="Interceptar: ir a por otro avion (blanco) y mantenerse en formacion con el. El foco de control se elige en EN FOCO."/>
                    <ToggleButton x:Name="GraphicsTab" Style="{StaticResource ActivityToggle}"
                                  FontFamily="Segoe MDL2 Assets" Content="&#xE891;"
                                  Checked="OnLeftViewChanged" Click="OnLeftViewClick"
                                  ToolTip="Graficos: lineas, triangulo, marcadores sobre aviones"/>
                    <ToggleButton x:Name="DataLogTab" Style="{StaticResource ActivityToggle}"
                                  FontFamily="Segoe MDL2 Assets" Content="&#xE9D2;"
                                  Checked="OnLeftViewChanged" Click="OnLeftViewClick"
                                  ToolTip="Caja negra: log de datos CSV + acceso a graficos"/>
                    <ToggleButton x:Name="ConfigTab" Style="{StaticResource ActivityToggle}"
                                  FontFamily="Segoe MDL2 Assets" Content="&#xE713;"
                                  Checked="OnLeftViewChanged" Click="OnLeftViewClick"
                                  ToolTip="Config: limites de control (rampas, agresividad, G, envolventes)"/>
                    <ToggleButton x:Name="XPlaneTab" Style="{StaticResource ActivityToggle}"
                                  FontFamily="Segoe MDL2 Assets" Content="&#xE7F4;"
                                  Checked="OnLeftViewChanged" Click="OnLeftViewClick"
                                  ToolTip="X-Plane: anclar ventana, marco y recuadro yoke"/>
                </StackPanel>
            </Border>

            <!-- === Panel izquierdo: una vista a la vez (despegue / acciones / ...) === -->
            <Border Grid.Column="1" Background="{StaticResource SideBarBg}"
                    BorderBrush="{StaticResource ShellBorder}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Abajo del todo: estado de conexion con el plugin. -->
                    <Border DockPanel.Dock="Bottom" Background="{StaticResource ChromeBg}"
                            BorderBrush="{StaticResource ShellBorder}" BorderThickness="0,1,0,0"
                            Padding="14,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" Margin="0,0,8,0"
                                     Fill="{Binding ConnectionDotColor}"
                                     ToolTip="{Binding ConnectionStatus}"/>
                            <TextBlock Text="{Binding ConnectionStatus}"
                                       FontFamily="{StaticResource AICopilotFont}"
                                       FontSize="12" Foreground="{StaticResource TextDim}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="LeftPanelTitle" DockPanel.Dock="Top" Text="AVIONES"
                               Margin="14,10,14,2"
                               FontFamily="{StaticResource AICopilotFont}" FontSize="11"
                               Foreground="{StaticResource TextFaint}"/>

                    <!-- EN FOCO como seccion/boton (inline, sin Popup HWND). -->
                    <Border x:Name="FocusPickerHost" DockPanel.Dock="Top" Margin="14,0,14,10"
                            Background="{StaticResource InputBg}"
                            BorderBrush="{StaticResource ShellBorder}" BorderThickness="1"
                            CornerRadius="4" Padding="10,8"
                            ToolTip="Elige GLOBAL (vista aerea / zona) o un avion (ordenes). Un clic no mueve la camara; doble clic en la lista o 'Poner en foco' si.">
                        <StackPanel>
                            <TextBlock Text="EN FOCO" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                            <ToggleButton x:Name="FocusPickerToggle"
                                          Style="{StaticResource ToolToggle}"
                                          IsChecked="{Binding FocusPickerOpen, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                          Margin="0,2" Padding="10,8"
                                          ToolTip="Clic = foco de ordenes sin cambiar la vista. GLOBAL reaplica vista aerea. Doble clic en Aviones / Poner en foco = camara.">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="&#xE70D;"
                                               FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               Foreground="{StaticResource CyanText}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <TextBlock Text="{Binding FocusText}"
                                               FontFamily="{StaticResource AICopilotFont}" FontSize="13"
                                               Foreground="{StaticResource CyanText}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                            </ToggleButton>
                            <Border x:Name="FocusPickerListHost"
                                    BorderBrush="{StaticResource ShellBorder}" BorderThickness="0,1,0,0"
                                    Visibility="{Binding FocusPickerListVisibility}"
                                    MaxHeight="220" Margin="0,4,0,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding AircraftEntries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Click="OnFocusPickerItemClick"
                                                        Cursor="Hand" HorizontalContentAlignment="Stretch"
                                                        Background="Transparent" BorderThickness="0"
                                                        Padding="10,6" Tag="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Row" Background="{TemplateBinding Background}"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <DockPanel>
                                                                    <Ellipse Width="7" Height="7" Margin="0,0,8,0"
                                                                             VerticalAlignment="Center"
                                                                             Fill="{Binding StatusBrush}"/>
                                                                    <TextBlock Text="{Binding FocusLabel}"
                                                                               FontFamily="{StaticResource AICopilotFont}"
                                                                               FontSize="12.5"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               VerticalAlignment="Center">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{StaticResource CyanText}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </DockPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Row" Property="Background"
                                                                            Value="{StaticResource HoverBg}"/>
                                                                </Trigger>
                                                                <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                                                    <Setter TargetName="Row" Property="Background"
                                                                            Value="{StaticResource HoverBg}"/>
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Las vistas ocupan el mismo hueco; solo una Visible a la vez. -->
                    <Grid>
                    <!-- Vista: roster global de aviones / foco / camara. -->
                    <ScrollViewer x:Name="AircraftView" VerticalScrollBarVisibility="Auto"
                                  Padding="14,4,14,14">
                        <StackPanel>
                            <TextBlock Text="AVIONES / FOCO" Style="{StaticResource SectionHeader}" Margin="0,4,0,6"/>
                            <TextBlock Text="GLOBAL = opciones de zona (graficos, inicios de simulacion, vista aerea). Un avion = ordenes de vuelo y caja negra."
                                       TextWrapping="Wrap" Margin="0,0,0,6"
                                       FontFamily="{StaticResource AICopilotFont}" FontSize="11"
                                       Foreground="{StaticResource TextFaint}"/>
                            <TextBlock Text="{Binding AircraftEmptyHint}" TextWrapping="Wrap"
                                       Margin="0,0,0,6"
                                       FontFamily="{StaticResource AICopilotFont}" FontSize="12"
                                       Foreground="{StaticResource TextFaint}"
                                       Visibility="{Binding AircraftEmptyVisibility}"/>

                            <ListBox x:Name="AircraftList" MaxHeight="420"
                                     ItemsSource="{Binding AircraftEntries}"
                                     SelectedItem="{Binding SelectedAircraft, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     MouseDoubleClick="OnFocusAircraftClick"
                                     ToolTip="Clic = selecciona. Doble clic = poner en foco y cambiar camara (chase en IA). 'Seguir con camara' solo en IA.">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <DockPanel>
                                                <Ellipse Width="8" Height="8" Margin="0,0,8,0"
                                                         VerticalAlignment="Center"
                                                         Fill="{Binding StatusBrush}"/>
                                                <TextBlock Text="FOCO"
                                                           FontFamily="{StaticResource AICopilotFont}"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{StaticResource CyanText}"
                                                           VerticalAlignment="Center"
                                                           DockPanel.Dock="Right" Margin="8,0,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding RoleLabel}"
                                                           FontFamily="{StaticResource AICopilotFont}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextFaint}"
                                                           VerticalAlignment="Center"
                                                           DockPanel.Dock="Right" Margin="8,0,0,0"/>
                                                <TextBlock Text="{Binding Name}"
                                                           FontFamily="{StaticResource AICopilotFont}"
                                                           FontSize="13"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsGlobal}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                                         FontFamily="{StaticResource AICopilotFont}"
                                                         FontSize="13"
                                                         MaxLength="32"
                                                         ToolTip="Nombre overlay en X-Plane. Vacio = sin etiqueta. Enter o salir del campo para aplicar."
                                                         LostFocus="OnAircraftNameLostFocus"
                                                         KeyDown="OnAircraftNameKeyDown"
                                                         GotKeyboardFocus="OnAircraftNameGotFocus"
                                                         LostKeyboardFocus="OnAircraftNameLostKeyboardFocus">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox" BasedOn="{StaticResource ShellTextBox}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsGlobal}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Detail}" Margin="16,3,0,0"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                       Foreground="{StaticResource TextDim}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Margin" Value="0,1"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Chrome"
                                                            Background="{StaticResource InputBg}"
                                                            BorderBrush="{StaticResource ShellBorder}"
                                                            BorderThickness="1" Padding="8,6">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Chrome" Property="Background"
                                                                    Value="{StaticResource HoverBg}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Chrome" Property="Background"
                                                                    Value="{StaticResource HoverBg}"/>
                                                            <Setter TargetName="Chrome" Property="BorderBrush"
                                                                    Value="{StaticResource CyanText}"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                                            <Setter TargetName="Chrome" Property="BorderBrush"
                                                                    Value="{StaticResource CyanText}"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>

                            <Button Style="{StaticResource AccentButton}" Content="Poner en foco"
                                    Click="OnFocusAircraftClick" HorizontalAlignment="Stretch"
                                    Margin="0,6,0,2"
                                    ToolTip="Aplica el foco y mueve la camara (vista aerea en GLOBAL; chase en IA; soltar en local). El desplegable EN FOCO solo cambia ordenes."/>
                            <Button Style="{StaticResource AccentButton}" Content="Seguir con camara"
                                    Click="OnFollowCameraClick" HorizontalAlignment="Stretch"
                                    Margin="0,2"
                                    ToolTip="Chase camara de X-Plane detras del avion IA seleccionado (no el local ni GLOBAL)."/>
                            <Button Style="{StaticResource ToolButton}" Content="Soltar camara"
                                    Click="OnReleaseCameraClick" HorizontalAlignment="Stretch"
                                    Margin="0,2,0,2"
                                    ToolTip="Devuelve el control de camara a X-Plane (tambien sale de la vista aerea)."/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Vista: estilo de despegue, tipo de vuelo y boton Iniciar. -->
                    <ScrollViewer x:Name="TakeoffView" VerticalScrollBarVisibility="Auto"
                                  Padding="14,4,14,14" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="ESTILO DESPEGUE" Style="{StaticResource SectionHeader}" Margin="0,4,0,6"/>

                            <ToggleButton x:Name="StyleRelaxed" Style="{StaticResource ToolToggle}"
                                          Content="Relajado" IsChecked="True" HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Center" Margin="0,2"
                                          Checked="OnStyleChanged" Click="OnStyleClick"
                                          ToolTip="Salida de entrenamiento: 250 kt y viraje suave."/>
                            <ToggleButton x:Name="StyleCombat" Style="{StaticResource ToolToggle}"
                                          Content="Combate" HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Center" Margin="0,2"
                                          Checked="OnStyleChanged" Click="OnStyleClick"
                                          ToolTip="Salida tactica: 350 kt, morro arriba, viraje pronto."/>
                            <ToggleButton x:Name="StyleEmergency" Style="{StaticResource ToolToggle}"
                                          Content="Emergencia" HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Center" Margin="0,2"
                                          Checked="OnStyleChanged" Click="OnStyleClick"
                                          ToolTip="Obstaculo o pista corta: rotar pronto y ganar angulo."/>

                            <TextBlock Text="{Binding StyleSummary}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       FontFamily="{StaticResource AICopilotFont}" FontSize="12.5"
                                       Foreground="{StaticResource TextDim}"/>
                            <TextBlock Text="{Binding StyleSpec}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Style="{StaticResource TelemetryText}"/>

                            <TextBlock Text="TIPO DE VUELO" Style="{StaticResource SectionHeader}"/>
                            <ToggleButton x:Name="FlightStraight" Style="{StaticResource ToolToggle}"
                                          Content="Recto estabilizado" IsChecked="True" HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Center" Margin="0,2"
                                          Checked="OnFlightModeChanged" Click="OnFlightModeClick"
                                          ToolTip="Recto y nivelado a ~300 kt, sin cambiar de rumbo."/>
                            <ToggleButton x:Name="FlightWanderer" Style="{StaticResource ToolToggle}"
                                          Content="Movedizo" HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Center" Margin="0,2"
                                          Checked="OnFlightModeChanged" Click="OnFlightModeClick"
                                          ToolTip="Tramos cortos y muchas vueltas amplias."/>
                            <ToggleButton x:Name="FlightNormal" Style="{StaticResource ToolToggle}"
                                          Content="Vuelo normal" HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Center" Margin="0,2"
                                          Checked="OnFlightModeChanged" Click="OnFlightModeClick"
                                          ToolTip="Va recto un rato y de vez en cuando hace una vuelta suave."/>

                            <TextBlock Text="{Binding FlightModeSummary}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       FontFamily="{StaticResource AICopilotFont}" FontSize="12.5"
                                       Foreground="{StaticResource TextDim}"/>

                            <TextBlock Text="ACCIONES EN RUTA" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="{Binding RouteActionsHint}"
                                       Margin="0,0,0,6" TextWrapping="Wrap"
                                       FontFamily="{StaticResource AICopilotFont}" FontSize="11.5"
                                       Foreground="{StaticResource TextDim}"/>

                            <TextBlock Text="Giro abierto" Margin="0,2,0,2"
                                       FontFamily="{StaticResource AICopilotFont}" FontSize="11.5"
                                       Foreground="{StaticResource TextDim}"/>
                            <Grid Margin="0,0,0,4" IsEnabled="{Binding RouteActionsEnabled}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource ToolButton}"
                                        Content="Izquierda" Tag="TurnGentleLeft"
                                        Click="OnRouteActionClick" HorizontalAlignment="Stretch"
                                        FontSize="11.5" Margin="0,1"
                                        ToolTip="Viraje suave (~20° alabeo, entrada lenta) ~90° a la izquierda."/>
                                <Button Grid.Column="2" Style="{StaticResource ToolButton}"
                                        Content="Derecha" Tag="TurnGentleRight"
                                        Click="OnRouteActionClick" HorizontalAlignment="Stretch"
                                        FontSize="11.5" Margin="0,1"
                                        ToolTip="Viraje suave (~20° alabeo, entrada lenta) ~90° a la derecha."/>
                            </Grid>

                            <TextBlock Text="Giro cerrado" Margin="0,4,0,2"
                                       FontFamily="{StaticResource AICopilotFont}" FontSize="11.5"
                                       Foreground="{StaticResource TextDim}"/>
                            <Grid Margin="0,0,0,4" IsEnabled="{Binding RouteActionsEnabled}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource ToolButton}"
                                        Content="Izquierda" Tag="TurnTightLeft"
                                        Click="OnRouteActionClick" HorizontalAlignment="Stretch"
                                        FontSize="11.5" Margin="0,1"
                                        ToolTip="Viraje cerrado (~60° / 2 g) ~90° a la izquierda."/>
                                <Button Grid.Column="2" Style="{StaticResource ToolButton}"
                                        Content="Derecha" Tag="TurnTightRight"
                                        Click="OnRouteActionClick" HorizontalAlignment="Stretch"
                                        FontSize="11.5" Margin="0,1"
                                        ToolTip="Viraje cerrado (~60° / 2 g) ~90° a la derecha."/>
                            </Grid>

                            <TextBlock Text="Altitud objetivo" Margin="0,4,0,2"
                                       FontFamily="{StaticResource AICopilotFont}" FontSize="11.5"
                                       Foreground="{StaticResource TextDim}"/>
                            <Grid Margin="0,0,0,4" IsEnabled="{Binding RouteActionsEnabled}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource ToolButton}"
                                        Content="−1.000 ft" Tag="AltDown1000"
                                        Click="OnRouteActionClick" HorizontalAlignment="Stretch"
                                        FontSize="11.5" Margin="0,1"
                                        ToolTip="Baja la altitud objetivo del crucero 1.000 ft."/>
                                <Button Grid.Column="2" Style="{StaticResource ToolButton}"
                                        Content="+1.000 ft" Tag="AltUp1000"
                                        Click="OnRouteActionClick" HorizontalAlignment="Stretch"
                                        FontSize="11.5" Margin="0,1"
                                        ToolTip="Sube la altitud objetivo del crucero 1.000 ft."/>
                            </Grid>

                            <TextBlock Text="SECUENCIA" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="{Binding SequenceText}" Style="{StaticResource TelemetryText}"
                                       Foreground="{StaticResource CyanText}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ChecklistText}" Style="{StaticResource TelemetryText}"
                                       Margin="0,6,0,0"/>

                            <TextBlock Text="CONTROL" Style="{StaticResource SectionHeader}"/>
                            <Button Style="{StaticResource AccentButton}" Content="Iniciar"
                                    Click="OnStartClick" HorizontalAlignment="Stretch" Margin="0,2"
                                    ToolTip="En tierra: despegue con el estilo elegido y luego el tipo de vuelo. En el aire: aplica el tipo de vuelo."/>
                            <Button Style="{StaticResource DangerButton}" Content="Abortar / manual"
                                    Click="OnAbortClick" HorizontalAlignment="Stretch" Margin="0,4,0,2"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Vista: catalogo de maniobras.
                         Cada boton lleva en Tag el nombre del ManeuverKind (Domain/Maneuvers.cs)
                         y comparte OnManeuverClick. Abortar vive en la vista de despegue
                         y corta tambien cualquier accion en marcha. -->
                    <ScrollViewer x:Name="ActionsView" VerticalScrollBarVisibility="Auto"
                                  Padding="14,4,14,14" Visibility="Collapsed">
                        <StackPanel x:Name="ActionsStack">
                            <TextBlock Text="ALTITUD" Style="{StaticResource SectionHeader}" Margin="0,4,0,6"/>
                            <Button Style="{StaticResource ToolButton}" Content="Bajar altitud (leve)" Tag="DescendGentle"
                                    Click="OnManeuverClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    FontSize="11.5" Margin="0,1"/>
                            <Button Style="{StaticResource ToolButton}" Content="Bajar altitud (agresivo)" Tag="DescendAggressive"
                                    Click="OnManeuverClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    FontSize="11.5" Margin="0,1"/>
                            <Button Style="{StaticResource ToolButton}" Content="Caer en picado" Tag="Dive"
                                    Click="OnManeuverClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    FontSize="11.5" Margin="0,1"/>
                            <Button Style="{StaticResource ToolButton}" Content="Subir morro (leve)" Tag="ClimbGentle"
                                    Click="OnManeuverClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    FontSize="11.5" Margin="0,1"/>
                            <Button Style="{StaticResource ToolButton}" Content="Subir morro (agresivo)" Tag="ClimbAggressive"
                                    Click="OnManeuverClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    FontSize="11.5" Margin="0,1"/>
                            <Button Style="{StaticResource ToolButton}" Content="Nivelar (alas y morro)" Tag="LevelWings"
                                    Click="OnManeuverClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    FontSize="11.5" Margin="0,1"/>

                            <TextBlock Text="VIRAJES" Style="{StaticResource SectionHeader}"/>
                            <Button Style="{StaticResource ToolButton}" Content="Virar suave, izquierda" Tag="TurnGentleLeft"
                                    Click="OnManeuverClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    FontSize="11.5" Margin="0,1"/>
                            <Button Style="{StaticResource ToolButton}" Content="Virar suave, derecha" Tag="TurnGentleRight"
                                    Click="OnManeuverClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    FontSize="11.5" Margin="0,1"/>
                            <Button Style="{StaticResource ToolButton}" Content="Virar cerrado, izquierda" Tag="TurnTightLeft"
                                    Click="OnManeuverClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    FontSize="11.5" Margin="0,1"/>
                            <Button Style="{StaticResource ToolButton}" Content="Virar cerrado, derecha" Tag="TurnTightRight"
                                    Click="OnManeuverClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    FontSize="11.5" Margin="0,1"/>

                            <TextBlock Text="COMBINADAS" Style="{StaticResource SectionHeader}"/>
                            <Button Style="{StaticResource ToolButton}" Content="Subir agresivo + virar izq." Tag="ClimbAggressiveTurnLeft"
                                    Click="OnManeuverClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    FontSize="11.5" Margin="0,1"/>
                            <Button Style="{StaticResource ToolButton}" Content="Subir agresivo + virar der." Tag="ClimbAggressiveTurnRight"
                                    Click="OnManeuverClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    FontSize="11.5" Margin="0,1"/>
                            <Button Style="{StaticResource ToolButton}" Content="Bajar agresivo + virar izq." Tag="DescendAggressiveTurnLeft"
                                    Click="OnManeuverClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    FontSize="11.5" Margin="0,1"/>
                            <Button Style="{StaticResource ToolButton}" Content="Bajar agresivo + virar der." Tag="DescendAggressiveTurnRight"
                                    Click="OnManeuverClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    FontSize="11.5" Margin="0,1"/>
                            <Button Style="{StaticResource ToolButton}" Content="Break defensivo, izquierda" Tag="CombatBreakLeft"
                                    Click="OnManeuverClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    FontSize="11.5" Margin="0,1"/>
                            <Button Style="{StaticResource ToolButton}" Content="Break defensivo, derecha" Tag="CombatBreakRight"
                                    Click="OnManeuverClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    FontSize="11.5" Margin="0,1"/>

                            <TextBlock Text="ACROBACIAS" Style="{StaticResource SectionHeader}"/>
                            <Button Style="{StaticResource ToolButton}" Content="Rollo (aleron), izquierda" Tag="RollLeft"
                                    Click="OnManeuverClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    FontSize="11.5" Margin="0,1"/>
                            <Button Style="{StaticResource ToolButton}" Content="Rollo (aleron), derecha" Tag="RollRight"
                                    Click="OnManeuverClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    FontSize="11.5" Margin="0,1"/>
                            <Button Style="{StaticResource ToolButton}" Content="Barrel roll, izquierda" Tag="BarrelRollLeft"
                                    Click="OnManeuverClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    FontSize="11.5" Margin="0,1"/>
                            <Button Style="{StaticResource ToolButton}" Content="Barrel roll, derecha" Tag="BarrelRollRight"
                                    Click="OnManeuverClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    FontSize="11.5" Margin="0,1"/>
                            <Button Style="{StaticResource ToolButton}" Content="Looping (backflip)" Tag="LoopBackflip"
                                    Click="OnManeuverClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    FontSize="11.5" Margin="0,1"/>
                            <Button Style="{StaticResource ToolButton}" Content="Immelmann, sale izquierda" Tag="ImmelmannLeft"
                                    Click="OnManeuverClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    FontSize="11.5" Margin="0,1"/>
                            <Button Style="{StaticResource ToolButton}" Content="Immelmann, sale derecha" Tag="ImmelmannRight"
                                    Click="OnManeuverClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    FontSize="11.5" Margin="0,1"/>
                            <Button Style="{StaticResource ToolButton}" Content="Split-S, entra izquierda" Tag="SplitSLeft"
                                    Click="OnManeuverClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    FontSize="11.5" Margin="0,1"/>
                            <Button Style="{StaticResource ToolButton}" Content="Split-S, entra derecha" Tag="SplitSRight"
                                    Click="OnManeuverClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    FontSize="11.5" Margin="0,1"/>

                            <TextBlock Text="VELOCIDAD" Style="{StaticResource SectionHeader}"/>
                            <Button Style="{StaticResource ToolButton}" Content="Acelerar" Tag="Accelerate"
                                    Click="OnManeuverClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    FontSize="11.5" Margin="0,1"/>
                            <Button Style="{StaticResource ToolButton}" Content="Frenar" Tag="Decelerate"
                                    Click="OnManeuverClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    FontSize="11.5" Margin="0,4,0,2"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Vista: catalogo de maniobras.
                         El orden de arriba abajo es el de la decision: a quien,
                         donde me pongo, a que distancia, y solo entonces el
                         boton. El estado va el ultimo porque es lo que se mira
                         DESPUES de haber pulsado. -->
                    <ScrollViewer x:Name="InterceptView" VerticalScrollBarVisibility="Auto"
                                  Padding="14,4,14,14" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="BLANCO" Style="{StaticResource SectionHeader}" Margin="0,4,0,6"/>
                            <TextBlock Text="{Binding InterceptEmptyHint}" TextWrapping="Wrap"
                                       Margin="0,0,0,6"
                                       FontFamily="{StaticResource AICopilotFont}" FontSize="12"
                                       Foreground="{StaticResource TextFaint}"
                                       Visibility="{Binding InterceptEmptyVisibility}"/>

                            <ListBox x:Name="InterceptTargetList" MaxHeight="230"
                                     ItemsSource="{Binding InterceptTargets}"
                                     SelectedItem="{Binding SelectedInterceptTarget, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <DockPanel>
                                                <Ellipse Width="8" Height="8" Margin="0,0,8,0"
                                                         VerticalAlignment="Center"
                                                         Fill="{Binding StatusBrush}"/>
                                                <TextBlock Text="{Binding StateLabel}"
                                                           FontFamily="{StaticResource AICopilotFont}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextFaint}"
                                                           VerticalAlignment="Center"
                                                           DockPanel.Dock="Right" Margin="8,0,0,0"/>
                                                <TextBlock Text="{Binding Name}"
                                                           FontFamily="{StaticResource AICopilotFont}"
                                                           FontSize="13"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Detail}" Margin="16,3,0,0"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                       Foreground="{StaticResource TextDim}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Margin" Value="0,1"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Chrome"
                                                            Background="{StaticResource InputBg}"
                                                            BorderBrush="{StaticResource ShellBorder}"
                                                            BorderThickness="1" Padding="8,6">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Chrome" Property="Background"
                                                                    Value="{StaticResource HoverBg}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Chrome" Property="Background"
                                                                    Value="{StaticResource HoverBg}"/>
                                                            <Setter TargetName="Chrome" Property="BorderBrush"
                                                                    Value="{StaticResource CyanText}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>

                            <TextBlock Text="PUESTO ALREDEDOR DEL BLANCO" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="Una bolita 3D en el simulador marca el punto exacto. Se mueve en tiempo real al ajustar los reguladores (0 = delante de su morro, 90 = derecha, 180 = cola, 270 = izquierda)."
                                       TextWrapping="Wrap" FontFamily="{StaticResource AICopilotFont}" FontSize="12.5"
                                       Foreground="{StaticResource TextDim}"/>
                            <StackPanel Margin="0,3" ToolTip="Angulo alrededor del avion blanco: 0 = delante, 90 = derecha, 180 = detras, 270 = izquierda.">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource TelemetryText}"
                                               Foreground="{StaticResource CyanText}" Margin="8,0,0,0"
                                               Text="{Binding StationAzimuthDeg, StringFormat={}{0:0}°}"/>
                                    <TextBlock Text="Azimut (360°)" Style="{StaticResource FieldLabel}"/>
                                </DockPanel>
                                <Slider Style="{StaticResource ShellSlider}" Minimum="0" Maximum="359"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding StationAzimuthDeg, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Margin="0,3" ToolTip="Distancia horizontal al blanco.">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource TelemetryText}"
                                               Foreground="{StaticResource CyanText}" Margin="8,0,0,0"
                                               Text="{Binding StationDistanceM, StringFormat={}{0:0} m}"/>
                                    <TextBlock Text="Distancia" Style="{StaticResource FieldLabel}"/>
                                </DockPanel>
                                <Slider Style="{StaticResource ShellSlider}" Minimum="0" Maximum="1000"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding StationDistanceM, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Margin="0,3" ToolTip="Altura sobre (+) o bajo (-) el blanco.">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource TelemetryText}"
                                               Foreground="{StaticResource CyanText}" Margin="8,0,0,0"
                                               Text="{Binding StationHeightM, StringFormat={}{0:0} m}"/>
                                    <TextBlock Text="Altura" Style="{StaticResource FieldLabel}"/>
                                </DockPanel>
                                <Slider Style="{StaticResource ShellSlider}" Minimum="-300" Maximum="300"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding StationHeightM, Mode=TwoWay}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding InterceptStationSpec}" Margin="0,6,0,0"
                                       TextWrapping="Wrap" Style="{StaticResource TelemetryText}"
                                       Foreground="{StaticResource CyanText}"/>
                            <ToggleButton Style="{StaticResource ToolToggle}" Content="Mostrar bola del puesto"
                                          IsChecked="{Binding ShowStationMarker, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                          Margin="0,6,0,0"
                                          ToolTip="Dibuja en X-Plane la bola donde el interceptor quiere estar respecto al blanco elegido."/>

                            <TextBlock Text="ZONA DE SEGURIDAD" Style="{StaticResource SectionHeader}"/>
                            <StackPanel Margin="0,3" ToolTip="Radio horizontal alrededor del blanco que nunca se invade. Tiempo real.">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource TelemetryText}"
                                               Foreground="{StaticResource CyanText}" Margin="8,0,0,0"
                                               Text="{Binding SafeHorizontalM, StringFormat={}{0:0} m}"/>
                                    <TextBlock Text="Horizontal (plano)" Style="{StaticResource FieldLabel}"/>
                                </DockPanel>
                                <Slider Style="{StaticResource ShellSlider}" Minimum="5" Maximum="100"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding SafeHorizontalM, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Margin="0,3" ToolTip="Semialtura de la zona de seguridad: solo cuenta si ademas se esta dentro del radio horizontal. Tiempo real.">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource TelemetryText}"
                                               Foreground="{StaticResource CyanText}" Margin="8,0,0,0"
                                               Text="{Binding SafeVerticalM, StringFormat={}{0:0} m}"/>
                                    <TextBlock Text="Vertical (altura)" Style="{StaticResource FieldLabel}"/>
                                </DockPanel>
                                <Slider Style="{StaticResource ShellSlider}" Minimum="2" Maximum="60"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding SafeVerticalM, Mode=TwoWay}"/>
                            </StackPanel>

                            <TextBlock Text="CONTROL" Style="{StaticResource SectionHeader}"/>
                            <Button Style="{StaticResource AccentButton}" Content="Interceptar"
                                    Click="OnInterceptStartClick" HorizontalAlignment="Stretch" Margin="0,2"
                                    ToolTip="Si estas en tierra, despega en modo combate a minima altura y luego gira hacia el blanco. Si ya vuelas, persigue directamente."/>
                            <Button Style="{StaticResource DangerButton}" Content="Cancelar interceptacion"
                                    Click="OnInterceptAbortClick" HorizontalAlignment="Stretch" Margin="0,4,0,2"/>

                            <TextBlock Text="SECUENCIA" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="{Binding InterceptSequenceText}" Style="{StaticResource TelemetryText}"
                                       Foreground="{StaticResource CyanText}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding InterceptChecklistText}" Style="{StaticResource TelemetryText}"
                                       Margin="0,6,0,0"/>

                            <TextBlock Text="ESTADO" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="{Binding InterceptStatusText}" TextWrapping="Wrap"
                                       Style="{StaticResource TelemetryText}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Vista: caja negra / log de datos crudo. Empezar/Detener
                         controlan el DataLogger del avion EN FOCO; con foco
                         GLOBAL actuan sobre todo el roster a la vez. Con
                         grabacion activa Refresh alimenta a ~10Hz todos los
                         que graben. "Ver graficos" abre la pestana del
                         viewport (en GLOBAL muestra LOCAL como vista); "Borrar
                         todo" vacia buffer UI + fichero(s) del alcance actual. -->
                    <DockPanel x:Name="DataLogView" Visibility="Collapsed">
                        <StackPanel DockPanel.Dock="Top" Margin="14,0,14,6">
                            <TextBlock Text="{Binding DataLogStatusText}"
                                       FontFamily="{StaticResource AICopilotFont}" FontSize="12"
                                       Foreground="{StaticResource TextDim}" VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="DataLogStartBtn" Style="{StaticResource AccentButton}"
                                        Content="Empezar a grabar" FontSize="12" Padding="10,4"
                                        Margin="0,0,6,0" Click="OnStartDataLogClick"
                                        ToolTip="Avion en foco: registra su telemetria (~10 Hz). GLOBAL: registra todos los aviones del roster a la vez (cada uno en su CSV)."/>
                                <Button x:Name="DataLogStopBtn" Style="{StaticResource DangerButton}"
                                        Content="Detener" FontSize="12" Padding="10,4"
                                        Margin="0,0,6,0" IsEnabled="False"
                                        Click="OnStopDataLogClick"
                                        ToolTip="Avion en foco: deja de grabar esa nave. GLOBAL: detiene todas las grabaciones."/>
                                <Button Style="{StaticResource ToolButton}" Content="Ver graficos"
                                        FontSize="12" Padding="8,2" Margin="0,0,6,0"
                                        Click="OnShowBlackBoxChartsClick"
                                        ToolTip="Abre la pestana Caja negra en el viewport (graficos del avion EN FOCO; en GLOBAL muestra LOCAL)"/>
                                <Button Style="{StaticResource ToolButton}" Content="Borrar todo"
                                        FontSize="12" Padding="8,2" Click="OnClearDataLogClick"
                                        ToolTip="Avion en foco: borra muestras y CSV de esa nave. GLOBAL: borra los de todo el roster."/>
                            </StackPanel>
                            <TextBlock Text="{Binding DataLogFilePathText}" Margin="0,4,0,0"
                                       FontFamily="{StaticResource MonoFont}" FontSize="10"
                                       Foreground="{StaticResource TextFaint}" TextWrapping="Wrap"
                                       ToolTip="CSV del avion EN FOCO, o lista de ficheros del roster en GLOBAL"/>
                        </StackPanel>
                        <ListBox x:Name="DataLogList" ItemsSource="{Binding DataLogSamples}"
                                 Background="Transparent" BorderThickness="0" Padding="10,0,10,10"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource TelemetryText}"
                                               FontSize="10.5"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </DockPanel>

                    <!-- Vista: Config, "limites humanos" del control (rampas de
                         mando, agresividad de maniobras, backstop de G, tiempos
                         de reaccion/captura del despegue, envolvente de
                         velocidad de Acelerar/Frenar). Ver Domain/ControlTuning.cs
                         para el porque de que estos y no otros: p. ej. las
                         ganancias de los PID y los parametros muy atados a una
                         fase concreta del despegue se quedan fuera a proposito. -->
                    <ScrollViewer x:Name="ConfigView" VerticalScrollBarVisibility="Auto"
                                  Padding="14,4,14,14" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="MANDOS / RAMPAS" Style="{StaticResource SectionHeader}" Margin="0,4,0,6"/>

                            <Grid Margin="0,3" ToolTip="Cuanto puede cambiar el throttle como maximo por segundo (0=ralenti .. 1=maxima potencia).">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="76"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Rampa motor (1/s)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ShellTextBox}"
                                         Text="{Binding ThrottleSlewRateText, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Grid Margin="0,3" ToolTip="Cuanto puede cambiar el mando de cabeceo como maximo por segundo (escala -1..1).">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="76"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Rampa cabeceo (1/s)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ShellTextBox}"
                                         Text="{Binding PitchSlewRateText, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Grid Margin="0,3" ToolTip="Cuanto puede cambiar el mando de alabeo como maximo por segundo (escala -1..1).">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="76"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Rampa alabeo (1/s)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ShellTextBox}"
                                         Text="{Binding RollSlewRateText, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Grid Margin="0,3" ToolTip="Cuanto puede cambiar el mando de guinada/rueda de morro como maximo por segundo (escala -1..1).">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="76"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Rampa guinada (1/s)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ShellTextBox}"
                                         Text="{Binding YawSlewRateText, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <TextBlock Text="AGRESIVIDAD DE ACCIONES" Style="{StaticResource SectionHeader}"/>

                            <Grid Margin="0,3" ToolTip="Ritmo (deg/s) al que se mueve el objetivo de pitch que persiguen las maniobras de Acciones (subir/bajar/virar). Mas alto = reacciona mas rapido a la orden.">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="76"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Rampa pitch obj. (deg/s)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ShellTextBox}"
                                         Text="{Binding ManeuverPitchRampText, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Grid Margin="0,3" ToolTip="Ritmo (deg/s) al que se mueve el objetivo de bank que persiguen los virajes de Acciones.">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="76"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Rampa bank obj. (deg/s)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ShellTextBox}"
                                         Text="{Binding ManeuverBankRampText, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Grid Margin="0,3" ToolTip="Ritmo (1/s) al que se mete el gesto de palanca fijo en rollos/loopings/Immelmann/Split-S (maniobras de tipo RateCommand).">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="76"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Rampa gesto palanca (1/s)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ShellTextBox}"
                                         Text="{Binding ManeuverStickRampText, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <TextBlock Text="LIMITES DE ACTITUD Y G" Style="{StaticResource SectionHeader}"/>

                            <Grid Margin="0,3" ToolTip="G de trabajo: la proteccion continua empieza a quitar mando antes de llegar aqui, sin cortar la maniobra.">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="76"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="G max. (limitador)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ShellTextBox}"
                                         Text="{Binding GSoftHighText, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Grid Margin="0,3" ToolTip="G negativa de trabajo (mas negativo = mas margen). Por encima de este valor el mando se suaviza, no se corta.">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="76"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="G min. (limitador)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ShellTextBox}"
                                         Text="{Binding GSoftLowText, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Grid Margin="0,3" ToolTip="Backstop estructural: la maniobra solo se corta si la G pasa de aqui y se mantiene. No deberia saltar nunca en vuelo normal.">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="76"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="G max. (abort duro)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ShellTextBox}"
                                         Text="{Binding GHardHighText, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Grid Margin="0,3" ToolTip="Backstop estructural en negativo. Igual que el anterior: solo corta si se mantiene.">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="76"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="G min. (abort duro)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ShellTextBox}"
                                         Text="{Binding GHardLowText, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Grid Margin="0,3" ToolTip="Altura sobre el terreno por debajo de la cual ninguna maniobra sigue bajando. Cada maniobra puede pedir mas, nunca menos.">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="76"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Suelo AGL (ft)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ShellTextBox}"
                                         Text="{Binding TerrainFloorAglText, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <ToggleButton x:Name="AutoSpeedbrakeToggle" Style="{StaticResource ToolToggle}"
                                          Content="Aerofrenos automaticos" IsChecked="True"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                          FontSize="11.5" Margin="0,6,0,1"
                                          Checked="OnAutoSpeedbrakeToggled" Unchecked="OnAutoSpeedbrakeToggled"
                                          ToolTip="El planificador saca los aerofrenos cuando hay que perder velocidad y el ralenti no basta. Apagalo para medir la resistencia del avion limpio (calibracion)."/>
                            <Grid Margin="0,3" ToolTip="Cuanto puede ajustar el pitch el autopiloto de nivelado (V/S=0) alrededor del pitch de crucero.">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="76"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Ajuste max. nivelado (deg)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ShellTextBox}"
                                         Text="{Binding LevelFlightMaxPitchAdjustText, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <TextBlock Text="El alabeo, la reaccion y la rampa de pitch del despegue los fija el estilo (Despegue), no estos limites."
                                       Margin="0,8,0,0" TextWrapping="Wrap"
                                       FontFamily="{StaticResource AICopilotFont}" FontSize="12"
                                       Foreground="{StaticResource TextFaint}"/>

                            <TextBlock Text="RECUPERACION DE NIVELADO" Style="{StaticResource SectionHeader}"/>

                            <Grid Margin="0,3" ToolTip="Tolerancia de bank (deg) para considerar 'nivelado recuperado' tras acabar una accion/maniobra.">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="76"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Captura bank (deg)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ShellTextBox}"
                                         Text="{Binding RecoverBankCaptureText, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Grid Margin="0,3" ToolTip="Tolerancia de pitch (deg) para considerar 'nivelado recuperado' tras acabar una accion/maniobra.">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="76"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Captura pitch (deg)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ShellTextBox}"
                                         Text="{Binding RecoverPitchCaptureText, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Grid Margin="0,3" ToolTip="Segundos que hay que mantenerse dentro de las tolerancias de arriba antes de dar el nivelado por recuperado.">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="76"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Tiempo minimo (s)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ShellTextBox}"
                                         Text="{Binding RecoverMinSecondsText, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <TextBlock Text="ENVOLVENTE DE VELOCIDAD" Style="{StaticResource SectionHeader}"/>

                            <Grid Margin="0,3" ToolTip="Cuantos nudos sube/baja el IAS objetivo cada vez que se pulsa Acelerar/Frenar en Acciones.">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="76"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Escalon Acelerar/Frenar (kt)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ShellTextBox}"
                                         Text="{Binding SpeedStepText, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Grid Margin="0,3" ToolTip="IAS objetivo minimo al que puede llegar Frenar (kt).">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="76"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="IAS obj. minimo (kt)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ShellTextBox}"
                                         Text="{Binding MinTargetIasText, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Grid Margin="0,3" ToolTip="IAS objetivo maximo al que puede llegar Acelerar (kt).">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="76"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="IAS obj. maximo (kt)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource ShellTextBox}"
                                         Text="{Binding MaxTargetIasText, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <Button Style="{StaticResource ToolButton}" Content="Restablecer valores por defecto"
                                    Click="OnResetTuningClick" HorizontalAlignment="Stretch" Margin="0,14,0,2"
                                    ToolTip="Vuelve a poner todos los campos de esta pestana en los valores de fabrica."/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Vista: overlays 2D en X-Plane (lineas / triangulo / marcadores). -->
                    <ScrollViewer x:Name="GraphicsView" VerticalScrollBarVisibility="Auto"
                                  Padding="14,4,14,14" Visibility="Collapsed">
                        <StackPanel>
                            <!-- Solo visible con foco GLOBAL (SyncFocusChrome). -->
                            <Border x:Name="SimStartSection"
                                    Background="{StaticResource InputBg}"
                                    BorderBrush="{StaticResource ShellBorder}" BorderThickness="1"
                                    CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="INICIOS DE SIMULACION" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                                    <Button Style="{StaticResource AccentButton}" Content="Inicio en pista: dos aviones"
                                            Tag="RunwayPair" Click="OnSimStartClick"
                                            HorizontalAlignment="Stretch" Margin="0,2"
                                            ToolTip="Solo en foco GLOBAL: caza en 06R y A330 en 06L (LEBL), los dos parados."/>
                                    <Button Style="{StaticResource AccentButton}" Content="Interceptacion desde tierra"
                                            Tag="InterceptFromGround" Click="OnSimStartClick"
                                            HorizontalAlignment="Stretch" Margin="0,2"
                                            ToolTip="Solo en foco GLOBAL: caza en 06R; A330 a 10 km, FL210, alejandose en ruta vuelo normal."/>
                                    <Button Style="{StaticResource AccentButton}" Content="Interceptacion en el aire"
                                            Tag="InterceptAirborne" Click="OnSimStartClick"
                                            HorizontalAlignment="Stretch" Margin="0,2"
                                            ToolTip="Solo en foco GLOBAL: caza a 20.000 ft, A330 a 28.000 ft, 15 km delante y 5 km a la derecha, caza interceptando, A330 en ruta vuelo normal."/>
                                    <Button Style="{StaticResource AccentButton}" Content="Interceptacion en el aire: cerca"
                                            Tag="InterceptAirborneClose" Click="OnSimStartClick"
                                            HorizontalAlignment="Stretch" Margin="0,2"
                                            ToolTip="Solo en foco GLOBAL: caza a 20.000 ft, A330 a 24.000 ft, a 5 km (delante y a la derecha), caza interceptando, A330 en ruta vuelo normal."/>
                                    <Button Style="{StaticResource AccentButton}" Content="Formacion en el aire"
                                            Tag="Formation" Click="OnSimStartClick"
                                            HorizontalAlignment="Stretch" Margin="0,2,0,2"
                                            ToolTip="Solo en foco GLOBAL: caza y A330 ya en formacion de ala a 20.000 ft y 200 m/s, mismo rumbo; el caza mantiene el puesto (paralelo izquierda)."/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource InputBg}"
                                    BorderBrush="{StaticResource ShellBorder}" BorderThickness="1"
                                    CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="DIBUJO" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                                    <ToggleButton x:Name="GfxLinesToggle" Style="{StaticResource ToolToggle}"
                                                  Content="Lineas (distancia)" IsChecked="False"
                                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                  Margin="0,2"
                                                  Checked="OnGraphicsChanged" Unchecked="OnGraphicsChanged"
                                                  ToolTip="Linea recta cyan hasta cada IA con la distancia 3D en metros"/>
                                    <ToggleButton x:Name="GfxTriangleToggle" Style="{StaticResource ToolToggle}"
                                                  Content="Triangulo (Δ horiz / Δ alt)" IsChecked="False"
                                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                  Margin="0,2"
                                                  Checked="OnGraphicsChanged" Unchecked="OnGraphicsChanged"
                                                  ToolTip="Cateto horizontal (naranja) y vertical/altitud (verde) respecto a cada IA — forma un triangulo rectangulo con la linea de distancia"/>
                                    <ToggleButton x:Name="GfxMarkersToggle" Style="{StaticResource ToolToggle}"
                                                  Content="Marcador (rombo)" IsChecked="False"
                                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                  Margin="0,2"
                                                  Checked="OnGraphicsChanged" Unchecked="OnGraphicsChanged"
                                                  ToolTip="Rombo identificador en el centro de cada avion visible"/>
                                    <ToggleButton x:Name="GfxPathToggle" Style="{StaticResource ToolToggle}"
                                                  Content="Vector de trayectoria" IsChecked="False"
                                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                  Margin="0,2"
                                                  Checked="OnGraphicsChanged" Unchecked="OnGraphicsChanged"
                                                  ToolTip="Predice donde estara el avion en ~1.5 s (integra velocidad+aceleracion). Sale 2.5 m por delante del CG; el horizonte se alarga/acorta con la acel. longitudinal"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource InputBg}"
                                    BorderBrush="{StaticResource ShellBorder}" BorderThickness="1"
                                    CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="ESTILO" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                                    <Grid Margin="0,3" ToolTip="Fuente del SDK: Basica es mas pequena; Proporcional es la habitual.">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Estilo" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="GfxFontCombo" Grid.Column="1"
                                                  SelectedIndex="1" SelectionChanged="OnGraphicsFontChanged">
                                            <ComboBoxItem Content="Basica"/>
                                            <ComboBoxItem Content="Proporcional"/>
                                        </ComboBox>
                                    </Grid>
                                    <Grid Margin="0,3" ToolTip="Color RGB 0..255 de nombres, rombos y trayectoria (las lineas del triangulo tienen color fijo).">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Color R G B" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="GfxColorR" Grid.Column="1" Style="{StaticResource ShellTextBox}"
                                                 Text="255" Margin="2,0,0,0" LostFocus="OnGraphicsChanged" KeyDown="OnGraphicsTextKeyDown"/>
                                        <TextBox x:Name="GfxColorG" Grid.Column="2" Style="{StaticResource ShellTextBox}"
                                                 Text="217" Margin="2,0,0,0" LostFocus="OnGraphicsChanged" KeyDown="OnGraphicsTextKeyDown"/>
                                        <TextBox x:Name="GfxColorB" Grid.Column="3" Style="{StaticResource ShellTextBox}"
                                                 Text="26" Margin="2,0,0,0" LostFocus="OnGraphicsChanged" KeyDown="OnGraphicsTextKeyDown"/>
                                    </Grid>
                                    <Grid Margin="0,3" ToolTip="Escala del marcador y grosor de linea (0.5 .. 4). Valores altos tambien engrosan el texto.">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="76"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Tamano" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="GfxScaleText" Grid.Column="1" Style="{StaticResource ShellTextBox}"
                                                 Text="1" LostFocus="OnGraphicsChanged" KeyDown="OnGraphicsTextKeyDown"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Button Style="{StaticResource ToolButton}" Content="Restablecer graficos"
                                    Click="OnResetGraphicsClick" HorizontalAlignment="Stretch" Margin="0,4,0,2"
                                    ToolTip="Apaga lineas, triangulo, rombos y trayectoria; color y tamano por defecto."/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Vista: anclar ventana de X-Plane, marco y recuadro yoke. -->
                    <ScrollViewer x:Name="XPlaneView" VerticalScrollBarVisibility="Auto"
                                  Padding="14,4,14,14" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="VENTANA" Style="{StaticResource SectionHeader}" Margin="0,4,0,6"/>
                            <ToggleButton x:Name="AttachToggle" Style="{StaticResource ToolToggle}"
                                          Content="Anclar X-Plane" IsChecked="True"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                          Margin="0,2"
                                          Checked="OnAttachToggled" Unchecked="OnAttachToggled"
                                          ToolTip="Mueve y redimensiona la ventana de X-Plane para que llene el hueco central"/>
                            <ToggleButton x:Name="FrameToggle" Style="{StaticResource ToolToggle}"
                                          Content="Ocultar marco" IsChecked="True"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                          Margin="0,2"
                                          Checked="OnFrameToggled" Unchecked="OnFrameToggled"
                                          ToolTip="Le quita a X-Plane la barra de titulo y el borde para que no se vea la costura"/>
                            <Button Style="{StaticResource ToolButton}" Content="Recolocar"
                                    Click="OnRedockClick"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Margin="0,2"
                                    ToolTip="Vuelve a encajar X-Plane ahora mismo"/>

                            <TextBlock Text="CONTROL" Style="{StaticResource SectionHeader}"/>
                            <ToggleButton x:Name="MouseYokeBoxToggle" Style="{StaticResource ToolToggle}"
                                          Content="Ocultar recuadro yoke" IsChecked="True"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                          Margin="0,2"
                                          Checked="OnMouseYokeBoxToggled" Unchecked="OnMouseYokeBoxToggled"
                                          ToolTip="Quita el recuadro del mouse yoke de X-Plane y de paso desactiva el control por raton, para que la IA no lo mueva sin querer"/>
                        </StackPanel>
                    </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="2" Width="5" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Style="{StaticResource ShellSplitter}"/>

            <!-- === Centro: hueco para X-Plane + log === -->
            <Grid Grid.Column="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="160"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition x:Name="BottomRow" Height="170" MinHeight="80"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Pestanas del viewport: X-Plane (sim anclado) o Caja negra
                         (graficos de telemetria). Al cambiar a graficos el docker
                         libera el hueco para que no lo tape el simulador. -->
                    <Border Grid.Row="0" Background="{StaticResource ChromeBg}">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="ViewportXPlaneTab" IsChecked="True"
                                          Checked="OnViewportTabChanged" Click="OnViewportTabClick"
                                          ToolTip="Vista del simulador anclado en este hueco">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="14,0"/>
                                        <Setter Property="Height" Value="30"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                                            BorderBrush="Transparent" BorderThickness="0,2,0,0"
                                                            Padding="{TemplateBinding Padding}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Ellipse x:Name="Dot" Width="7" Height="7" Margin="0,0,7,0"
                                                                     Fill="{Binding DockDotColor}"/>
                                                            <ContentPresenter VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource ViewportBg}"/>
                                                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource CyanText}"/>
                                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBg}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="FontFamily" Value="{StaticResource AICopilotFont}"/>
                                        <Setter Property="FontSize" Value="12.5"/>
                                    </Style>
                                </ToggleButton.Style>
                                <TextBlock Text="{Binding ViewportTabText}" VerticalAlignment="Center"/>
                            </ToggleButton>
                            <ToggleButton x:Name="ViewportBlackBoxTab"
                                          Checked="OnViewportTabChanged" Click="OnViewportTabClick"
                                          ToolTip="Caja negra: graficos de telemetria para calibrar la computadora de vuelo">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="14,0"/>
                                        <Setter Property="Height" Value="30"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                                            BorderBrush="Transparent" BorderThickness="0,2,0,0"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource ViewportBg}"/>
                                                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource CyanText}"/>
                                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBg}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="FontFamily" Value="{StaticResource AICopilotFont}"/>
                                        <Setter Property="FontSize" Value="12.5"/>
                                    </Style>
                                </ToggleButton.Style>
                                <TextBlock Text="Caja negra" VerticalAlignment="Center"/>
                            </ToggleButton>
                        </StackPanel>
                    </Border>

                    <!-- ESTE es el hueco. XPlaneDocker traduce su rectangulo en
                         pantalla a un SetWindowPos sobre la ventana del sim, asi
                         que todo lo que se pinte aqui queda tapado en cuanto
                         X-Plane encaja. La vista de caja negra se muestra
                         encima y el docker deja de cubrir el hueco. -->
                    <Grid Grid.Row="1">
                        <Border x:Name="Viewport" Background="{StaticResource ViewportBg}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding ViewportHintVisibility}">
                                <TextBlock Text="{Binding ViewportHintTitle}" HorizontalAlignment="Center"
                                           FontFamily="{StaticResource AICopilotFont}" FontSize="18"
                                           Foreground="{StaticResource TextDim}"/>
                                <TextBlock Text="{Binding ViewportHintDetail}" HorizontalAlignment="Center"
                                           TextAlignment="Center" MaxWidth="440" TextWrapping="Wrap"
                                           FontFamily="{StaticResource AICopilotFont}" FontSize="13"
                                           Foreground="{StaticResource TextFaint}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="BlackBoxHost" Background="{StaticResource ViewportBg}"
                                Visibility="Collapsed"/>
                    </Grid>
                </Grid>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch" Style="{StaticResource ShellSplitter}"/>

                <!-- === Panel inferior: log === -->
                <Border Grid.Row="2" Background="{StaticResource SideBarBg}"
                        BorderBrush="{StaticResource ShellBorder}" BorderThickness="0,1,0,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{StaticResource ChromeBg}" Padding="14,0">
                            <Grid Height="28">
                                <TextBlock Text="LOG DE ACCIONES" VerticalAlignment="Center"
                                           FontFamily="{StaticResource AICopilotFont}" FontSize="11"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <Button Style="{StaticResource ToolButton}" Content="Limpiar"
                                        HorizontalAlignment="Right" FontSize="12" Padding="8,2"
                                        Click="OnClearLogClick"/>
                            </Grid>
                        </Border>
                        <ListBox x:Name="LogList" ItemsSource="{Binding Logs}"
                                 Background="Transparent" BorderThickness="0" Padding="10,6"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource TelemetryText}"
                                               TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0,1"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter x:Name="RightSplitter" Grid.Column="4" Width="5" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Style="{StaticResource ShellSplitter}"/>

            <!-- === Panel derecho: telemetria (siempre visible; vacio en
                 GLOBAL para no resizear el docker de X-Plane). === -->
            <Border x:Name="TelemetryPanel" Grid.Column="5" Background="{StaticResource SideBarBg}"
                    BorderBrush="{StaticResource ShellBorder}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="10,8,10,2">
                        <TextBlock Text="TELEMETRIA"
                                   FontFamily="{StaticResource AICopilotFont}" FontSize="10"
                                   Foreground="{StaticResource TextFaint}"/>
                        <TextBlock Text="{Binding FocusText}" Margin="0,1,0,0"
                                   FontFamily="{StaticResource AICopilotFont}" FontSize="10"
                                   Foreground="{StaticResource CyanText}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="Telemetria del avion EN FOCO (seccion EN FOCO del panel izquierdo)."/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,2,10,10">
                        <StackPanel>
                            <TextBlock Text="MODO" Style="{StaticResource SectionHeader}" Margin="0,4,0,4"/>
                            <TextBlock Text="{Binding ModeText}" Style="{StaticResource TelemetryText}"
                                       FontSize="11.5" Foreground="{StaticResource CyanText}" TextWrapping="Wrap"/>

                            <TextBlock Text="VUELO" Style="{StaticResource SectionHeader}" Margin="0,10,0,4"/>
                            <TextBlock Text="{Binding FlightText}" Style="{StaticResource TelemetryText}" FontSize="11.5"/>

                            <TextBlock Text="ACTITUD" Style="{StaticResource SectionHeader}" Margin="0,10,0,4"/>
                            <TextBlock Text="{Binding AttitudeText}" Style="{StaticResource TelemetryText}" FontSize="11.5"/>

                            <TextBlock Text="MANDOS" Style="{StaticResource SectionHeader}" Margin="0,10,0,4"/>
                            <TextBlock Text="{Binding ControlsText}" Style="{StaticResource TelemetryText}" FontSize="11.5"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ================= Barra de estado ================= -->
        <Border Grid.Row="2" Background="{StaticResource StatusBg}">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding ConnectionStatus}" Style="{StaticResource StatusText}"/>
                    <TextBlock Text="{Binding ModeText}" Style="{StaticResource StatusText}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding DockStatusText}" Style="{StaticResource StatusText}"/>
                    <TextBlock Text="{Binding BuildText}" Style="{StaticResource StatusText}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tooltip inline (mismo HWND del shell). Los ToolTip WPF abren un
             Popup HWND owned y Windows sube el shell por encima de X-Plane:
             el hueco se ve negro. Misma idea que el desplegable EN FOCO. -->
        <Border x:Name="InlineTip" Grid.RowSpan="3"
                Visibility="Collapsed" IsHitTestVisible="False"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="{StaticResource ChromeBg}"
                BorderBrush="{StaticResource CyanAccent}" BorderThickness="1"
                Padding="8,5" CornerRadius="2" MaxWidth="340"
                Panel.ZIndex="1000">
            <TextBlock x:Name="InlineTipText" TextWrapping="Wrap"
                       FontFamily="{StaticResource AICopilotFont}" FontSize="12.5"
                       Foreground="{StaticResource TextPrimary}"/>
        </Border>
    </Grid>
</Window>
